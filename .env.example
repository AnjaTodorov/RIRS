# Copy this file to .env in the repository root. Never commit real credentials.
# Supabase > Connect > Session pooler (port 5432).
# Percent-encode special characters in the password inside each URL.
DATABASE_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
# Needed later for server-side Supabase Auth/Storage operations, not SQL migrations.
SUPABASE_SECRET_KEY=""
